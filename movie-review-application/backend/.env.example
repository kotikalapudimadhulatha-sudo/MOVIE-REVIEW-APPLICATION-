# CineReview Hub — Environment Configuration
# Copy this file to .env and replace placeholder values with your actual Supabase credentials.

# Port for the Express.js server (Default: 3000)
PORT=3000

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Server-side privileged secret)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

